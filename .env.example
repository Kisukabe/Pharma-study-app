# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT (.env.local hoặc .env)
# ------------------------------------------------------------------------------
# API Key của Gemini từ Google AI Studio (bắt buộc cho backend):
GEMINI_API_KEY=your_gemini_api_key_here

# Cổng chạy Backend (mặc định 5000 cho dev, 7860 cho Hugging Face Spaces):
PORT=5000

# Danh sách domain Frontend được phép gọi API (phân cách bằng dấu phẩy):
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,*

# URL của Backend API (dùng cho Frontend kết nối đến Backend):
# Để trống khi chạy Monolith cùng cổng, hoặc điền URL backend khi deploy tách biệt:
VITE_API_BASE_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. VERCEL ENVIRONMENT VARIABLES (Cấu hình trên Vercel Dashboard)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=https://<your-hf-space-name>.hf.space

# ------------------------------------------------------------------------------
# 3. HUGGING FACE SPACES SECRETS (Cấu hình trong Space Settings > Variables & Secrets)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy...
# ALLOWED_ORIGINS=https://<your-vercel-domain>.vercel.app,*
# PORT=7860
